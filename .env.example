# このファイルを .env にコピーして値を入れる。
# .env は .gitignore 済みなのでGitHubには上がらない。人には見せないこと。
#
# 送信先は「値が入っているものだけ」有効になる。両方入れれば両方に届く。

# ───────── メール（いまはこちらを使う）─────────
# 送信元のGmailアドレス
SMTP_USER=
# Googleアカウントの「アプリパスワード」16桁。通常のログインパスワードでは動かない。
# 発行: https://myaccount.google.com/apppasswords （2段階認証の有効化が必要）
SMTP_PASSWORD=
# 受信するメールアドレス（SMTP_USER と同じでよい）
MAIL_TO=

# Gmail以外を使う場合だけ変更する
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# ───────── LINE（あとで追加する。空のままでよい）─────────
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=
